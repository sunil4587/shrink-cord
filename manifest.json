{
  "manifest_version": 3,
  "name": "DiscordShrink - Auto 25MB Video Squeezer",
  "version": "1.0.0",
  "description": "Automatically catches oversized videos on Discord Web and compresses them under 25MB right in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.discord.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DiscordShrink Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.discord.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ]
}
