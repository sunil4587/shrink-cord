{
  "manifest_version": 3,
  "name": "ShrinkCord - Auto Media Squeezer for Discord",
  "version": "1.2.0",
  "description": "Automatically compresses oversized videos and audio on Discord Web client-side under the 20MB limit without Nitro.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.discord.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShrinkCord Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.discord.com/*"
      ],
      "js": [
        "probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.discord.com/*"
      ],
      "js": [
        "fix-webm-duration.js",
        "compressor.js",
        "ui.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://*.discord.com/*"
      ]
    }
  ]
}
